default_platform(:ios)

platform :ios do
  desc "Run tests"
  lane :test do
    run_tests(scheme: "Dayline", devices: ["iPhone 17 Pro"])
  end

  desc "Build for simulator"
  lane :build do
    build_app(scheme: "Dayline", skip_archive: true, destination: "generic/platform=iOS Simulator")
  end
end
